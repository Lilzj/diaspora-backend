<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The PayPal payout adapter.

    A separate assembly for the reason `Diaspora.Payments.Stripe` is one: an architecture test
    refuses a vendor name inside `Diaspora.Modules.Financial`, and the module knows a provider only
    as a string in its capability matrix.

    One assembly per provider rather than one for all of them, which is where this differs from
    `Diaspora.Sms`. There, the unit of substitution is a routing table and splitting it across
    assemblies would have been worse. Here the routing table lives in the Financial module, so each
    vendor is genuinely independent — and a provider whose SDK, auth model or failure vocabulary
    changes should not force a rebuild of the others.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Diaspora.Payments.PayPal</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Diaspora.Modules.Financial\Diaspora.Modules.Financial.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Diaspora.UnitTests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="Microsoft.Extensions.Options.DataAnnotations" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

</Project>
