<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Diaspora.Modules.Providers</RootNamespace>
    <AssemblyName>Diaspora.Modules.Providers</AssemblyName>
    <Description>
      The Provider &amp; Service Ecosystem Engine (Phase B7). The platform's single owner of the
      idea that somebody offers something: individuals, businesses, organizations, churches,
      community groups, government services, schools, clinics and consultants, together with
      their services, prices, availability, service areas, certifications, languages, galleries,
      verification, reviews and recommendations.

      No later module implements its own provider model. Marketplace (B10), Jobs (B11), Housing
      (B12), Community Life (B13), Guides (B8), Events, Search (B15), Notifications (B16) and AI
      (B17) consume this module's published contracts. That is the whole design: Identity owns
      who you are, Trust owns what you have proven, Location owns where things are, Media owns
      the bytes, Community owns what members do to one another's content, and Providers owns who
      offers what, where, when and at what price.

      Service categories, verification, availability, pricing, ranking, search projections,
      recommendations and provider types are all contributor seams, so a new category tree, a new
      verification source or a new ranking algorithm is a new class in another assembly rather
      than an edit here.

      Registers entirely through B2.6 contributor interfaces: no edit to the Platform Kernel, the
      Identity module, the Trust module, the Location module, the Media module, the Community
      module, or Program.cs.
    </Description>
  </PropertyGroup>

  <!--
    The same reference set B6 uses, plus B6 itself.

    Location, Media and Community are deliberate and documented. B7 consumes Location's published
    Integration and Extensibility contracts (IGeographicScopeResolver, ILocationDirectory,
    IResidencyDirectory, INearbyResourceProvider, ILocationResourceCounter), Media's published
    reference contracts (MediaReference, MediaReferenceRoles, MediaOwnerType, Contracts.V1) and
    Community's published Integration and Extensibility contracts (ICommunityContentSource,
    ICommunityBookmarkService, ICommunitySocialService, ICommunityModerationService,
    IFeedProvider). All three are the consumption paths those modules' own contract freezes
    publish for verticals.

    Notably absent: the Identity module and the Trust module. Providers reaches Identity through
    the kernel's ICurrentUser and Trust through the kernel's ITrustService and Trust's published
    integration events in Diaspora.Contracts — never through their aggregates.
  -->
  <ItemGroup>
    <PackageReference Include="MediatR" />
    <PackageReference Include="FluentValidation" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Diaspora.SharedKernel\Diaspora.SharedKernel.csproj" />
    <ProjectReference Include="..\Diaspora.Contracts\Diaspora.Contracts.csproj" />
    <ProjectReference Include="..\Diaspora.Platform\Diaspora.Platform.csproj" />
    <ProjectReference Include="..\Diaspora.Application\Diaspora.Application.csproj" />
    <ProjectReference Include="..\Diaspora.Persistence\Diaspora.Persistence.csproj" />
    <ProjectReference Include="..\Diaspora.Modules.Location\Diaspora.Modules.Location.csproj" />
    <ProjectReference Include="..\Diaspora.Modules.Media\Diaspora.Modules.Media.csproj" />
    <ProjectReference Include="..\Diaspora.Modules.Community\Diaspora.Modules.Community.csproj" />
  </ItemGroup>

</Project>
