<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The SMS adapter: Twilio and Africa's Talking, chosen per destination.

    A separate assembly for the reason `Diaspora.Push.Firebase` is one. Identity owns the
    *policy* — what a one-time code is, how long it lives, how many attempts it allows — and
    architecture tests refuse a vendor name inside a module. The vendor is a value of
    `Sms:Routes`, never a type in the module. So the wire lives here, behind
    `IOtpDeliveryService`, and registers after Identity on last-registration-wins.

    Both vendors sit in one assembly rather than two, which is the one place this differs from
    the push adapter. The unit of substitution here is not "a provider" but "a routing table":
    the whole point is that a Nigerian number and a German number take different wires, and a
    router split across two assemblies that must agree on a prefix table is a worse seam than
    one assembly holding both. Adding a third vendor adds a file here, not a project.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Diaspora.Sms</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- The port (`IOtpDeliveryService`) and the resilience contracts it executes under. -->
    <ProjectReference Include="..\Diaspora.Application\Diaspora.Application.csproj" />
    <ProjectReference Include="..\Diaspora.Platform\Diaspora.Platform.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="Microsoft.Extensions.Options.DataAnnotations" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

</Project>
