<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Diaspora.ArchitectureTests</RootNamespace>
    <AssemblyName>Diaspora.ArchitectureTests</AssemblyName>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="NetArchTest.Rules" />

    <!--
      B1.2. Lets MessagingCompilerEnforcementTests compile illegal snippets in memory and
      assert the diagnostics, which is the only way to test a guarantee whose whole point is
      that the code cannot exist in this repository.
    -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />

    <!--
      Needed only to build an EF model in memory. ValueObjectSharingArchitectureTests reads
      owned-ness from the real model rather than guessing it from a base type, and building a
      model requires a provider. No connection is ever opened; owned-ness is a modelling
      decision and identical on every provider.
    -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
  </ItemGroup>

