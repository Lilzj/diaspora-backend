<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>

    <!--
      Lets a PackageVersion entry below override a version chosen by a transitive
      dependency. Without it, the two security pins at the bottom of this file would be
      inert: neither package is referenced directly by any project.
    -->
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>

    <!--
      Every Microsoft.* / System.* package below tracks the .NET 10 GA servicing band.
      B2.6 moved the graph off the 10.0.0-preview.5 packages it shipped on: those carried
      eight high-severity advisories through their transitive closure, which turned
      TreatWarningsAsErrors into a hard Release build failure. Keeping the whole band on a
      single GA version is also what makes the build reproducible — a preview band can be
      re-published under the same version string, a GA servicing release cannot.

      Rule for this file: one version variable per band, no per-package drift.
    -->
    <DotnetVersion>10.0.10</DotnetVersion>
    <OpenTelemetryVersion>1.17.0</OpenTelemetryVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- CQRS & Mediator -->
    <PackageVersion Include="MediatR" Version="12.4.1" />

    <!-- Validation -->
    <PackageVersion Include="FluentValidation" Version="11.11.0" />
    <PackageVersion Include="FluentValidation.DependencyInjectionExtensions" Version="11.11.0" />

    <!-- Mapping -->
    <PackageVersion Include="Mapster" Version="10.0.0" />
    <PackageVersion Include="Mapster.DependencyInjection" Version="10.0.0" />

    <!-- Logging -->
    <PackageVersion Include="Serilog" Version="4.4.0" />
    <PackageVersion Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageVersion Include="Serilog.Enrichers.Environment" Version="3.0.1" />
    <PackageVersion Include="Serilog.Enrichers.Thread" Version="4.0.0" />
    <PackageVersion Include="Serilog.Settings.Configuration" Version="10.0.0" />
    <PackageVersion Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageVersion Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageVersion Include="Serilog.Sinks.OpenTelemetry" Version="4.1.1" />

    <!-- OpenTelemetry -->
    <PackageVersion Include="OpenTelemetry" Version="$(OpenTelemetryVersion)" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="$(OpenTelemetryVersion)" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="$(OpenTelemetryVersion)" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="$(OpenTelemetryVersion)" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="$(OpenTelemetryVersion)" />
    <PackageVersion Include="OpenTelemetry.Exporter.Console" Version="$(OpenTelemetryVersion)" />

    <!-- Entity Framework Core -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="$(DotnetVersion)" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="$(DotnetVersion)" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="$(DotnetVersion)" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="$(DotnetVersion)" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />

    <!-- Identity, Authentication & Cryptography -->
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="$(DotnetVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Identity.Core" Version="$(DotnetVersion)" />
    <PackageVersion Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.21.0" />
    <PackageVersion Include="Microsoft.IdentityModel.Tokens" Version="8.21.0" />

    <!-- ASP.NET Core Extensions -->
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="$(DotnetVersion)" />
    <PackageVersion Include="Microsoft.Extensions.DependencyModel" Version="$(DotnetVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="$(DotnetVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="$(DotnetVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Options.DataAnnotations" Version="$(DotnetVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Abstractions" Version="$(DotnetVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="$(DotnetVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks" Version="$(DotnetVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" Version="$(DotnetVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="$(DotnetVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="$(DotnetVersion)" />

    <!-- API Documentation -->
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="$(DotnetVersion)" />

    <!--
      Transitive override. Microsoft.AspNetCore.OpenApi 10.0.10 resolves Microsoft.OpenApi
      2.0.0, which carries GHSA-v5pm-xwqc-g5wc. 2.11.0 is the patched release inside the
      same major, so the API surface AspNetCore.OpenApi compiles against is unchanged.
      Remove this pin when the ASP.NET Core servicing band moves past it on its own.
    -->
    <PackageVersion Include="Microsoft.OpenApi" Version="2.11.0" />

    <!--
      Build-time OpenAPI emission (M1). Tooling only: it contributes MSBuild targets that
      run the document generator after compilation and write the result to disk. Nothing in
      it is referenced by code, ships in the output, or is reachable at run time — see the
      PrivateAssets/IncludeAssets metadata on the PackageReference in Diaspora.Api.csproj.

      Pinned to the same servicing band as the rest of the Microsoft.* graph, because the
      generator it drives is the one inside Microsoft.AspNetCore.OpenApi: a tool from a
      different band would emit a document describing a different generator's behaviour.
    -->
    <PackageVersion Include="Microsoft.Extensions.ApiDescription.Server" Version="$(DotnetVersion)" />

    <PackageVersion Include="Scalar.AspNetCore" Version="2.16.16" />
    <PackageVersion Include="Asp.Versioning.Http" Version="8.1.1" />
    <PackageVersion Include="Asp.Versioning.Mvc.ApiExplorer" Version="8.1.1" />

    <!-- Testing -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="FluentAssertions" Version="8.10.0" />
    <PackageVersion Include="NSubstitute" Version="5.3.0" />
    <PackageVersion Include="AutoFixture" Version="4.18.1" />
    <PackageVersion Include="AutoFixture.Xunit2" Version="4.18.1" />
    <PackageVersion Include="NetArchTest.Rules" Version="1.3.2" />

    <!--
      B1.2. The messaging boundary is enforced by the compiler rather than by convention, and
      a claim of that shape is only worth what its proof is worth: the architecture suite
      compiles the illegal snippets in memory against the real platform assemblies and asserts
      the exact diagnostic each one produces. A test that merely asserts the legal code works
      would stay green on the day the boundary is removed.
    -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.0.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="$(DotnetVersion)" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.4.0" />

    <!--
      Test host only. The real SignalR client, so the hub is exercised the way a phone exercises
      it — negotiate, handshake, authenticate, subscribe, receive — rather than by calling hub
      methods directly on an instance the test constructed. A hub tested by construction proves the
      C# compiles; it proves nothing about whether a token survives the upgrade, whether the user
      identifier resolves, or whether a payload serialises into the shape a client binds to. Those
      are the three things that actually break.
    -->
    <PackageVersion Include="Microsoft.AspNetCore.SignalR.Client" Version="$(DotnetVersion)" />

    <!--
      Transitive override, test host only. EF Core's SQLite provider resolves
      SQLitePCLRaw.lib.e_sqlite3 2.1.11 (GHSA-2m69-gcr7-jv3q); 2.1.12 is the patch.
      The native library never reaches a deployed artifact — SQLite is the integration
      suite's database — but a vulnerability that only fails in CI still fails CI.
    -->
    <PackageVersion Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.12" />
    <PackageVersion Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.12" />
    <PackageVersion Include="SQLitePCLRaw.core" Version="2.1.12" />
    <PackageVersion Include="SQLitePCLRaw.provider.e_sqlite3" Version="2.1.12" />

    <!-- JSON -->
    <PackageVersion Include="System.Text.Json" Version="$(DotnetVersion)" />
  </ItemGroup>

</Project>
